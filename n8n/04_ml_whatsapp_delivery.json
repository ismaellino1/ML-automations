          "id": "REPLACE_AFTER_IMPORT",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $json.job ?? $json;\nconst errors = [];\nif (!job.job_id) errors.push('JOB_ID_MISSING');\nif (!job.phone_number_id) errors.push('PHONE_NUMBER_ID_MISSING');\nif (!job.meta_payload || typeof job.meta_payload !== 'object') errors.push('META_PAYLOAD_MISSING');\nif (errors.length) throw new Error(`INVALID_OUTBOUND_JOB:${errors.join(',')}`);\nreturn { json: { job } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ],
      "id": "0055cf4a-857b-4f2b-94b5-4f63a1033ddd",
      "name": "02 - VALIDAR OUTBOUND"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/' + ($json.job.graph_api_version ?? 'v26.0') + '/' + $json.job.phone_number_id + '/messages' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.job.meta_payload }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        160,
        0
      ],
      "id": "cc8e42ca-c852-4c7a-a0ff-338f7e7c8fb9",
      "name": "03 - ENVIAR META WHATSAPP",
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_AFTER_IMPORT",
          "name": "WhatsApp account 6"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT core.complete_outbound_delivery(\n    $1::UUID,\n    $2::TEXT,\n    $3::JSONB\n) AS completion;",
        "options": {
          "queryReplacement": "={{ [\n  $('02 - VALIDAR OUTBOUND').item.json.job.job_id,\n  $json.messages?.[0]?.id ?? null,\n  JSON.stringify($json)\n] }}"
        }
      },
