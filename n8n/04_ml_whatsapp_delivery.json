        "options": {
          "queryReplacement": "={{ [\n  $('02 - VALIDAR OUTBOUND').item.json.job.job_id,\n  $json.error?.message ?? $json.message ?? $json.description ?? 'META_SEND_FAILED',\n  JSON.stringify($json)\n] }}"
