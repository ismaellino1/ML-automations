        "jsCode": "const job = $('02 - VALIDAR JOB CALENDAR').item.json.job;\nconst raw = $json ?? {};\nconst status = Number(\n  raw.statusCode ?? raw.httpCode ?? raw.error?.statusCode ??\n  raw.error?.httpCode ?? raw.error?.cause?.statusCode ?? 0\n);\nconst msg = String(raw.error?.message ?? raw.message ?? raw.description ?? '');\nconst absent = status === 404 || status === 410 || /not found|gone/i.test(msg);\nreturn { json: { job, route: absent ? 'ALREADY_GONE' : 'ERROR', raw } };"
