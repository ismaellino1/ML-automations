        "jsCode": "const items = $input.all();\nconst job = $('02 - VALIDAR JOB CALENDAR').item.json.job;\nconst markerA = `ML Appointment: ${job.appointment_id}`;\nconst markerB = `Appointment ID: ${job.appointment_id}`;\n\nconst found = items\n  .map(i => i.json ?? {})\n  .find(e => {\n    const d = String(e.description ?? '');\n    const status = String(e.status ?? '').toLowerCase();\n    return e.id && status !== 'cancelled' && (d.includes(markerA) || d.includes(markerB));\n  });\n\nreturn [{\n  json: {\n    job,\n    route: found ? 'FOUND' : 'CREATE',\n    existing_event_id: found?.id ?? null,\n    existing_event: found ?? null\n  }\n}];"
